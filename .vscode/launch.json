{
  "version": "0.2.0",
  "configurations": [{
    "name": "DCMViewer VS Code Extension",
    "type": "extensionHost",
    "request": "launch",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"],
    "outFiles": ["${workspaceFolder}/vscode-extension/out/**/*.js"],
    "preLaunchTask": "build:vscode"
  }]
}
